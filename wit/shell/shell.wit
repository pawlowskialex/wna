package acme:shell@1.0.0;

/// Keychain on iOS, Keystore on Android.
interface secrets {
  get: func(name: string) -> option<string>;
  set: func(name: string, value: string);
}

interface notify {
  record notification {
    id: string,
    title: string,
    body: string,
    at-ms: u64,
  }
  schedule: func(n: notification) -> result<_, string>;
  cancel: func(id: string);
}

interface config {
  get: func(key: string) -> option<string>;
}
